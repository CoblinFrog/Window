{
  "name": "@window/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "smoke": "tsx --env-file-if-exists=.env src/scripts/smoke.ts",
    "ingest": "tsx --env-file-if-exists=.env src/scripts/ingest.ts",
    "ingest:api": "tsx --env-file-if-exists=.env src/scripts/ingest-api.ts",
    "ingest:web": "tsx --env-file-if-exists=.env src/scripts/ingest-web.ts",
    "prune": "tsx --env-file-if-exists=.env src/scripts/prune-media.ts",
    "ingest:listings": "tsx --env-file-if-exists=.env src/scripts/ingest-listings.ts",
    "fill": "tsx --env-file-if-exists=.env src/scripts/fill-catalog.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@window/shared": "*",
    "express": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "supabase": "^2.117.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
