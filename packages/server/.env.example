# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
# Neither eBay nor Amazon may be scraped — both disallow their item and search
# paths in robots.txt — so both are reached through their official APIs, which
# is tier 1 in the PRD and the tier it says to prefer.

# --- eBay Browse API -------------------------------------------------------
# developer.ebay.com -> Hi <user> -> Application Keysets -> Production ->
# Create a keyset. Browse is read-only, so no extra approval is needed.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional:
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_CAMPAIGN_ID=            # affiliate attribution

# --- Amazon Product Advertising API 5.0 ------------------------------------
# Requires an Amazon Associates account AND at least three qualifying sales
# within 180 days before Amazon enables API access. Until then the keys exist
# but every call returns "AccessKey not enabled for Product Advertising API".
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
# Optional:
# AMAZON_MARKETPLACE_TLD=com
# AMAZON_SEARCH_INDEX=All

# --- Secrets ---------------------------------------------------------------
# Both are REQUIRED in production; the server refuses to boot without them.
# Unset in development, an ephemeral per-process value is generated and warned
# about. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Signs session tokens. Changing it invalidates every outstanding session.
AUTH_SECRET=
# Guards /internal (ranking debug and hot config reload). That endpoint dumps
# per-user ranking state for any user id, so this is a real credential.
INTERNAL_TOKEN=

# --- Network trust ---------------------------------------------------------
# Origins allowed to call the API from a browser. Comma-separated. Defaults to
# the Expo dev origins outside production and to EMPTY in production.
# CORS_ORIGINS=https://app.window.example

# Reverse-proxy hops to trust when reading X-Forwarded-For. Must match the
# deployment: too high and any client can spoof req.ip, which is the rate-limit
# key on the unauthenticated credential routes; too low and everyone behind the
# load balancer is rate-limited as one principal.
# TRUST_PROXY_HOPS=1

# --- Database --------------------------------------------------------------
# Supabase configuration (recommended)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Legacy MongoDB configuration (fallback)
# Point at Atlas to use real $vectorSearch; the local fallback runs otherwise.
# MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net
# ATLAS_VECTOR_SEARCH=1

# --- Browse agent (npm run ingest:web) ---------------------------------------
# The agent decides via the `claude` CLI in headless mode — a Claude Code
# subscription covers it and no API key is needed. Override to point at a
# different binary or pin a cheaper model for browse decisions.
# AGENT_LLM_BIN=claude
# AGENT_LLM_MODEL=haiku
# Where the curl_cffi helper persists per-domain session cookies.
# WINDOW_COOKIE_JAR_DIR=.data/cookies

# --- Email verification (development) ----------------------------------------
# Claiming an account is the one path that lets an identity spend money, and it
# is gated on a six-digit code emailed to the address. There is no mail
# transport configured, so outside production the code goes to the server log
# and to .data/dev-mail/ instead of to an inbox — and is pinned to a known
# value so a checkout run does not have to go and read it.
#
# Minting only. The code is still hashed, compared in constant time, limited to
# five attempts and spent on use; nothing accepts an unchecked code. Production
# ignores this outright and refuses to issue email challenges at all, because
# createMailer() throws without a real transport.
#
# Any other six-digit string pins to that instead; `random` (or any non-numeric
# value) restores the CSPRNG.
# DEV_EMAIL_CODE=111111
