# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
# Neither eBay nor Amazon may be scraped — both disallow their item and search
# paths in robots.txt — so both are reached through their official APIs, which
# is tier 1 in the PRD and the tier it says to prefer.

# --- eBay Browse API -------------------------------------------------------
# developer.ebay.com -> Hi <user> -> Application Keysets -> Production ->
# Create a keyset. Browse is read-only, so no extra approval is needed.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional:
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_CAMPAIGN_ID=            # affiliate attribution

# --- Amazon Product Advertising API 5.0 ------------------------------------
# Requires an Amazon Associates account AND at least three qualifying sales
# within 180 days before Amazon enables API access. Until then the keys exist
# but every call returns "AccessKey not enabled for Product Advertising API".
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
# Optional:
# AMAZON_MARKETPLACE_TLD=com
# AMAZON_SEARCH_INDEX=All

# --- Database --------------------------------------------------------------
# Point at Atlas to use real $vectorSearch; the local fallback runs otherwise.
# MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net
# ATLAS_VECTOR_SEARCH=1

# --- Browse agent (npm run ingest:web) ---------------------------------------
# The agent decides via the `claude` CLI in headless mode — a Claude Code
# subscription covers it and no API key is needed. Override to point at a
# different binary or pin a cheaper model for browse decisions.
# AGENT_LLM_BIN=claude
# AGENT_LLM_MODEL=haiku
# Where the curl_cffi helper persists per-domain session cookies.
# WINDOW_COOKIE_JAR_DIR=.data/cookies
